    Resolve --> Route{"Question Type"}
    Route -->|"Personal HRIS fact"| HRIS["Query HRIS Data"]
    Route -->|"Policy question"| Retrieve["Hybrid Vector and Text Search"]
    Route -->|"Out of scope"| Refuse["Return Safe Boundary Response"]
    Retrieve --> Context["Build Grounded Context"]
    HRIS --> Context
    Context --> Generate["Generate Answer with Active AI Provider"]
    Generate --> Usage["Record Usage Attribution"]
    Refuse --> Save["Save Conversation State"]
    Usage --> Save
    Save --> Reply["Return Answer to Chat UI"]

